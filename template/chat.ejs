    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
        integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/2.2.0/socket.io.js"></script>



    <script>
        var input = $('#message_input');
        var all_mess = $('#all_mess');
        var form = $('#messForm');
        var users = $('#users');
        var user;
        let audio = new Audio('/audio/notif.mp3');

    function slowScroll() {
            // var offset = 0;
            // $('#mess_container').animate({
            //     scrollTop: $(id).offset().top - offset
            // }, 60);
            // $('#mess_container').animate({scrollTop:$(id).offset().top+"px"},{duration:1E3});
            // return false;
            $('#mess_container').stop().animate({
  scrollTop: $('#mess_container')[0].scrollHeight
}, 800);
        }

    var window_focus = true;
        window.onblur = function () {
            window_focus = false;
            console.log('фокус ушел');
        }
        $(window).focus(function () {
            window_focus = true;
            console.log("фокус пришел");
        });

  var socket = io.connect('', {
    reconnect: false
  });

    // var timerId = setInterval(function() {
    //     socket.emit('update online');
    // }, 2000);

  socket
      .on('message', function(username, message) {
        console.log(user)
        if(username == user){
            printMessage('<div class="my_message"><div class="my_messagebox">'+message+'</div></div>');
        }else{
            printMessage('<div class="user_message"><div class="user_ava_conteiner"><div><img class="user_ava" src="https://files.everypony.ru/gallery/random-news-2/d12de1607a.png" alt="avatar" width="70px" height="70px"></div><div class="mess_username">'+username+'</div></div><div class="mess_box"><div class="user_messagebox">'+message+'</div></div></div>');
        }
        slowScroll();
        
        
        if(!window_focus){
            
            console.log('звук');
            var promise = audio.play();

if (promise !== undefined) {
    promise.then(_ => {
        audio.play();
    }).catch(error => {
        console.log('ошба')
    });
}
        }
      })
      .on('leave', function(username) {
        // printStatus(username + " вышел из чата");
        // socket.emit('update online');
      })
      .on('join', function(username) {
        // printStatus(username + " вошёл в чат");
        // socket.emit('update online');
        console.log(username);
        user = username;
        // console.log(user)
      })
      .on('connect', function() {
        // printStatus("соединение установлено");
        form.on('submit', sendMessage);
        input.prop('disabled', false);
        socket.emit('update online');
      })
      .on('disconnect', function() {
        // printStatus("соединение потеряно");
        form.off('submit', sendMessage);
        input.prop('disabled', true);
        this.$emit('error');
      })
      .on('logout', function() {
        location.href = "/";
      })
      .on('push online', function(onlineUsers){
            // console.log(onlineUsers);
            uniqueUsersOnline = unique(onlineUsers);
            // console.log(uniqueUsersOnline);
            // console.log('пришло');
            var html = '';
            for (i = 0; i < uniqueUsersOnline.length; i++) {
                html += '<div class="online_user"><img class="user_ava ava_online" src="https://files.everypony.ru/gallery/random-news-2/d12de1607a.png" alt="avatar" width="60px" height="60px"><h4 class="online_name">'+uniqueUsersOnline[i]+'</h4></div>';
            }
            users.html(html);
          
      })
      .on('error', function(reason) {
        if (reason == "handshake unauthorized") {
          printStatus("вы вышли из сайта");
        } else {
          setTimeout(function() {
            socket.socket.connect();
          }, 500);
        }
      });



    





    function unique(arr) {
        var obj = {};

        for (var i = 0; i < arr.length; i++) {
        var str = arr[i];
        obj[str] = true; // запомнить строку в виде свойства объекта
        }

        return Object.keys(obj); // или собрать ключи перебором для IE8-
    }
  function sendMessage() {
    if(input.val()){
    var text = input.val();
    socket.emit('message', text);

    input.val('');
    return false;
    }
    else{
        alert('Пожалуйста, не отправляйте пустые сообщения!')
        return false;
    }
  }

  function printStatus(status) {
    all_mess.append(status);
    // $('<li>').append($('<i>').text(status)).appendTo(ul);
  }

  function printMessage(text) {
    all_mess.append(text);
    // $('<li>').text(text).appendTo(ul);
  }

</script>
