# Server settings. node-config reads these from the environment
# (see config/custom-environment-variables.json); they override config/default.json.
# This file is not loaded automatically: export the variables or use your own tooling.
PORT=5000
JWT_SECRET=CHANGE_ME
MONGO_URI=mongodb://localhost:27017/twichat

# Optional: Cloudinary account used for avatars (server side deletes old avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
